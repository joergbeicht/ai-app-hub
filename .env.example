# Vorlage für die lokale .env (Docker Compose). Kopieren nach .env und Werte setzen.
# Die .env ist gitignored - echte Werte nie einchecken.

# --- Anmeldung (ADR-19) -------------------------------------------------------
# `keycloak` (Standard in Compose): Login über Keycloak mit dem Backend als BFF.
# `entra`: MSAL-Bestand (ADR-2/6/12/14).
AUTH_MODE=keycloak

# Lokaler Keycloak (https://localhost:6057, Admin-Konsole unter /admin).
KEYCLOAK_HOST_PORT=6057
# Bootstrap-Admin der Keycloak-Admin-Konsole (Benutzer `admin`).
# Erzeugen z. B. mit: openssl rand -hex 16
KEYCLOAK_ADMIN_PASSWORD=
# Client-Secret des BFF-Clients `ai-app-hub-bff` im Realm `axora`.
HUB_OIDC_CLIENT_SECRET=
# Passwort des Default-Admins `admin@axora.local` im Realm `axora` (mind. 12 Zeichen).
HUB_DEV_ADMIN_PASSWORD=

# --- Backend ------------------------------------------------------------------
# Nur setzen, wenn Port 6055 lokal belegt ist; dann auch BACKEND_API_URL anpassen.
BACKEND_HOST_PORT=6055
BACKEND_API_URL=https://localhost:6055

# --- Entra-Bestand (nur AUTH_MODE=entra bzw. Benutzerverwaltung/Tablet-Login) -
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEY_VAULT_URL=
TABLET_USERS_GROUP_ID=
TABLET_SESSION_JWT_SECRET=
