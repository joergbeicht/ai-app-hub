# Vorlage für die lokale .env (Docker Compose). Kopieren nach .env und Werte setzen.
# Die .env ist gitignored - echte Werte nie einchecken.

# --- Anmeldung (ADR-19) -------------------------------------------------------
# `keycloak` (Standard in Compose): Login über Keycloak mit dem Backend als BFF.
# `entra`: MSAL-Bestand (ADR-2/6/12/14).
AUTH_MODE=keycloak

# Lokaler Keycloak (https://localhost:6057, Admin-Konsole unter /admin).
KEYCLOAK_HOST_PORT=6057
# Bootstrap-Admin der Keycloak-Admin-Konsole (Benutzer `admin`).
# Erzeugen z. B. mit: openssl rand -hex 16
KEYCLOAK_ADMIN_PASSWORD=
# Client-Secret des BFF-Clients `ai-app-hub-bff` im Realm `axora`.
HUB_OIDC_CLIENT_SECRET=
# Passwort des Default-Admins `joergbeicht@outlook.de` im Realm `axora` (mind. 12 Zeichen).
HUB_DEV_ADMIN_PASSWORD=
# Client-Secret des Service-Accounts `axora-iam-api` (Benutzeranlage, Einladungen).
# Derselbe Wert gehört in axora-platform/.env.
IAM_KEYCLOAK_CLIENT_SECRET=

# --- Axora IAM (ADR-20) -------------------------------------------------------
# Schlüssel, mit dem das Backend die Keycloak-Tokens in der Sitzung verschlüsselt (AES-256-GCM).
# Erzeugen mit: openssl rand -base64 32
SESSION_TOKEN_KEY=
# Keycloak-Mails (OTP, Einladungen) gehen per SMTP an send-mail-with-azure (ADR-22), das über
# Microsoft Graph versendet. Der Dienst muss laufen (dort `docker compose up -d`).
KEYCLOAK_SMTP_HOST=host.docker.internal
KEYCLOAK_SMTP_PORT=6004
# Nur abfangen statt versenden: KEYCLOAK_SMTP_HOST=mailpit, KEYCLOAK_SMTP_PORT=1025,
# Mails dann unter http://localhost:6060
MAILPIT_HOST_PORT=6060

# --- Backend ------------------------------------------------------------------
# Nur setzen, wenn Port 6055 lokal belegt ist; dann auch BACKEND_API_URL anpassen.
BACKEND_HOST_PORT=6055
BACKEND_API_URL=https://localhost:6055

# --- Entra-Bestand (nur AUTH_MODE=entra bzw. Benutzerverwaltung/Tablet-Login) -
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEY_VAULT_URL=
TABLET_USERS_GROUP_ID=
TABLET_SESSION_JWT_SECRET=
