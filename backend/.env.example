# Nie committen mit echten Werten - siehe .gitignore (.env).

PORT=6055

# Erlaubte Frontend-Origins (CORS), kommagetrennt. Pro Kunden-Cluster unterschiedlich.
CORS_ORIGIN=https://localhost:6054

# Dieselbe App-Registrierung wie das Frontend (RUNTIME_CONFIG in ai-app-hub/frontend).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# NUR Backend: Client-Secret für den Microsoft-Graph-Client-Credentials-Flow (App-only,
# "Application permissions" User.Read.All + Application.Read.All + AppRoleAssignment.ReadWrite.All
# mit Admin-Consent). Niemals im Frontend/Bundle verwenden - siehe ADR-6.
AZURE_CLIENT_SECRET=
