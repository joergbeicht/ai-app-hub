FROM node:26-alpine

# git is needed so write-app-version.cjs can read the SemVer tag from the bind-mounted repo .git
# (APP_VERSION_GIT_DIR=/git in docker-compose.yml).
RUN apk add --no-cache git

WORKDIR /app

COPY package*.json ./
RUN npm install --legacy-peer-deps

COPY . .

EXPOSE 6054

# Overridden by docker-compose (ensure-node-modules + start:docker / HTTPS).
CMD ["npm", "run", "start:docker"]
