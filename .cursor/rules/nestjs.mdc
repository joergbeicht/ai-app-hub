globs: ["apps/*/src/**/*.ts", "**/*.controller.ts", "**/*.service.ts", "**/*.module.ts", "**/*.dto.ts", "**/*.guard.ts", "**/*.filter.ts", "**/main.ts"]
alwaysApply: false
