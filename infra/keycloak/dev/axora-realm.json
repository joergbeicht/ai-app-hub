{
  "realm": "axora",
  "displayName": "Axora",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "passwordPolicy": "length(8) and notUsername",
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "actionTokenGeneratedByAdminLifespan": 259200,
  "internationalizationEnabled": true,
  "supportedLocales": ["de", "en", "es", "fr", "tr", "it"],
  "defaultLocale": "de",
  "loginTheme": "axora",
  "emailTheme": "keycloak",
  "webAuthnPolicyPasswordlessRpEntityName": "Axora",
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "webAuthnPolicyPasswordlessMediation": "conditional",
  "browserFlow": "axora browser",
  "authenticationFlows": [
    {
      "alias": "axora browser",
      "description": "Password and email OTP; a passkey replaces both (ADR-21).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false },
        { "flowAlias": "axora browser forms", "requirement": "ALTERNATIVE", "priority": 20, "autheticatorFlow": true, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "axora browser forms",
      "description": "Email and password or passkey, then email OTP.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-password-form", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false },
        { "flowAlias": "axora browser email otp", "requirement": "CONDITIONAL", "priority": 20, "autheticatorFlow": true, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "axora browser email otp",
      "description": "Email OTP unless the user signed in with a passkey.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-credential", "authenticatorConfig": "axora-not-signed-in-with-passkey", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false },
        { "authenticator": "email-authenticator-no-enrollment", "authenticatorConfig": "axora-email-otp", "requirement": "REQUIRED", "priority": 20, "autheticatorFlow": false, "userSetupAllowed": false }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "axora-not-signed-in-with-passkey",
      "config": { "credentials": "webauthn-passwordless" }
    },
    {
      "alias": "axora-email-otp",
      "config": {
        "emailProviderType": "KEYCLOAK",
        "length": "6",
        "ttl": "300",
        "maxAttempts": "5",
        "resendCooldown": "30",
        "showMaskedEmailOnOtpForm": "true",
        "simulationMode": "false"
      }
    }
  ],
  "smtpServer": {
    "host": "${KEYCLOAK_SMTP_HOST}",
    "port": "${KEYCLOAK_SMTP_PORT}",
    "from": "no-reply@axora.local",
    "fromDisplayName": "Axora"
  },
  "clients": [
    {
      "clientId": "ai-app-hub-bff",
      "name": "AI App Hub",
      "baseUrl": "${HUB_FRONTEND_URL}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${HUB_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": ["${HUB_OIDC_REDIRECT_URI}"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${HUB_OIDC_POST_LOGOUT_REDIRECT_URI}",
        "axora.brand.app": "ai-app-hub"
      },
      "protocolMappers": [
        {
          "name": "axora-iam-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "axora-iam-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "axora-iam-api",
      "name": "Axora IAM API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${IAM_KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "axora-invitation",
      "name": "Axora invitation redirect",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["${HUB_FRONTEND_URL}"],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "joergbeicht@outlook.de",
      "email": "joergbeicht@outlook.de",
      "emailVerified": true,
      "firstName": "Hub",
      "lastName": "Administrator",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${HUB_DEV_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-axora-iam-api",
      "enabled": true,
      "serviceAccountClientId": "axora-iam-api",
      "clientRoles": {
        "realm-management": ["view-users", "query-users", "manage-users"]
      }
    }
  ]
}
