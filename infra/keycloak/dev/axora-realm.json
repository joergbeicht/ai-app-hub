{
  "realm": "axora",
  "displayName": "Axora",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and notUsername",
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "actionTokenGeneratedByAdminLifespan": 259200,
  "internationalizationEnabled": true,
  "supportedLocales": ["de", "en", "es", "fr", "tr", "it"],
  "defaultLocale": "de",
  "loginTheme": "axora",
  "emailTheme": "keycloak",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@axora.local",
    "fromDisplayName": "Axora"
  },
  "clients": [
    {
      "clientId": "ai-app-hub-bff",
      "name": "AI App Hub",
      "baseUrl": "${HUB_FRONTEND_URL}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${HUB_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": ["${HUB_OIDC_REDIRECT_URI}"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${HUB_OIDC_POST_LOGOUT_REDIRECT_URI}",
        "axora.brand.app": "ai-app-hub"
      },
      "protocolMappers": [
        {
          "name": "axora-iam-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "axora-iam-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "axora-iam-api",
      "name": "Axora IAM API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${IAM_KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "hub-admin",
      "email": "admin@axora.local",
      "emailVerified": true,
      "firstName": "Hub",
      "lastName": "Administrator",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${HUB_DEV_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-axora-iam-api",
      "enabled": true,
      "serviceAccountClientId": "axora-iam-api",
      "clientRoles": {
        "realm-management": ["view-users", "query-users", "manage-users"]
      }
    }
  ]
}
